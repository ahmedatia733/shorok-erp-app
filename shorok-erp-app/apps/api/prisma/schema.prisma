// ======================== Phase 4B: Vouchers ==========================
// Receipt/payment vouchers post through the PostingEngine in 4B-2/4B-3 (not
// here). Schema-only foundation: DRAFT rows may have no period/journal metadata.

model ReceiptVoucher {
  id                     String        @id @default(uuid()) @db.Uuid
  voucherNumber          BigInt        @unique @default(autoincrement()) @map("voucher_number")
  voucherDate            DateTime      @map("voucher_date") @db.Date
  branchId               String        @map("branch_id") @db.Uuid
  customerId             String        @map("customer_id") @db.Uuid
  treasuryAccountId      String        @map("treasury_account_id") @db.Uuid
  amount                 Decimal       @db.Decimal(18, 2)
  reference              String?       @db.VarChar(100)
  memo                   String?       @db.VarChar(300)
  status                 VoucherStatus @default(DRAFT)
  periodId               String?       @map("period_id") @db.Uuid
  journalEntryId         String?       @unique @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?       @unique @map("reversal_journal_entry_id") @db.Uuid
  createdBy              String        @map("created_by") @db.Uuid
  postedBy               String?       @map("posted_by") @db.Uuid
  reversedBy             String?       @map("reversed_by") @db.Uuid
  postedAt               DateTime?     @map("posted_at") @db.Timestamptz(6)
  reversedAt             DateTime?     @map("reversed_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch               Branch                     @relation("ReceiptVoucherBranch", fields: [branchId], references: [id], onDelete: Restrict)
  customer             Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  treasuryAccount      Account                    @relation("ReceiptVoucherTreasury", fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  period               FinancialPeriod?           @relation(fields: [periodId], references: [id])
  journalEntry         JournalEntry?              @relation("ReceiptVoucherJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntry JournalEntry?              @relation("ReceiptVoucherReversalJournal", fields: [reversalJournalEntryId], references: [id])
  creator              User                       @relation("ReceiptVoucherCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  poster               User?                      @relation("ReceiptVoucherPostedBy", fields: [postedBy], references: [id])
  reverser             User?                      @relation("ReceiptVoucherReversedBy", fields: [reversedBy], references: [id])
  allocations          ReceiptVoucherAllocation[]

  @@index([customerId])
  @@index([treasuryAccountId])
  @@index([status])
  @@index([periodId])
  @@index([branchId, voucherDate(sort: Desc)])
  @@map("receipt_vouchers")
}

model PaymentVoucher {
  id                     String        @id @default(uuid()) @db.Uuid
  voucherNumber          BigInt        @unique @default(autoincrement()) @map("voucher_number")
  voucherDate            DateTime      @map("voucher_date") @db.Date
