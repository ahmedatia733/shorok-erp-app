  treasuryAccountId      String        @map("treasury_account_id") @db.Uuid
  amount                 Decimal       @db.Decimal(18, 2)
  reference              String?       @db.VarChar(100)
  memo                   String?       @db.VarChar(300)
  status                 VoucherStatus @default(DRAFT)
  periodId               String?       @map("period_id") @db.Uuid
  journalEntryId         String?       @unique @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?       @unique @map("reversal_journal_entry_id") @db.Uuid
  createdBy              String        @map("created_by") @db.Uuid
  postedBy               String?       @map("posted_by") @db.Uuid
  reversedBy             String?       @map("reversed_by") @db.Uuid
  postedAt               DateTime?     @map("posted_at") @db.Timestamptz(6)
  reversedAt             DateTime?     @map("reversed_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
