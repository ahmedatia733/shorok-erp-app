  taxRegistrationNo    String?             @map("tax_registration_no") @db.VarChar(60)
  fiscalYearStartMonth Int                 @default(1) @map("fiscal_year_start_month")
  defaultLocale        String              @default("ar") @db.VarChar(5)
  printFooterAr        String?             @map("print_footer_ar")
  printFooterEn        String?             @map("print_footer_en")
