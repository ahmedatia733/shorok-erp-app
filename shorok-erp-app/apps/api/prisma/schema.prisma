// ========================= SalesInvoice ==============================

model SalesInvoice {
  id                    String    @id @default(uuid()) @db.Uuid
  invoiceNumber         BigInt    @unique @default(autoincrement()) @map("invoice_number")
  invoiceDate           DateTime  @map("invoice_date") @db.Date
  dueDate               DateTime? @map("due_date") @db.Date
  customerId            String    @map("customer_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  status                String    @default("DRAFT") @db.VarChar(20)
  notes                 String?   @db.VarChar(1000)
  subtotal              Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount        Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxRate               Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount             Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  grandTotal            Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  totalCost             Decimal   @default(0) @map("total_cost") @db.Decimal(14, 2)
  arAccountId           String?   @map("ar_account_id") @db.Uuid
  revenueAccountId      String?   @map("revenue_account_id") @db.Uuid
  taxAccountId          String?   @map("tax_account_id") @db.Uuid
  cogsAccountId         String?   @map("cogs_account_id") @db.Uuid
  inventoryAccountId    String?   @map("inventory_account_id") @db.Uuid
  journalEntryId        String?   @map("journal_entry_id") @db.Uuid
  cogsJournalEntryId    String?   @map("cogs_journal_entry_id") @db.Uuid
  customerTxId          String?   @map("customer_tx_id") @db.Uuid
  salesRepresentativeId String?   @map("sales_representative_id") @db.Uuid
  // Confirmed-invoice revision (additive). 1 = the original confirmation; each
  // posted revision increments it. lastRevisedBy is an unconstrained UUID, the
  // same convention this model already uses for customerTxId / journalEntryId.
  revisionNumber        Int       @default(1) @map("revision_number")
  lastRevisedAt         DateTime? @map("last_revised_at") @db.Timestamptz(6)
  lastRevisedBy         String?   @map("last_revised_by") @db.Uuid
  createdBy             String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer            Customer                   @relation(fields: [customerId], references: [id])
  branch              Branch                     @relation("SalesInvoiceBranch", fields: [branchId], references: [id])
  creator             User                       @relation("SalesInvoiceCreatedBy", fields: [createdBy], references: [id])
  salesRepresentative SalesRepresentative?       @relation(fields: [salesRepresentativeId], references: [id], onDelete: Restrict)
  lines               SalesInvoiceLine[]
  orders              CustomerOrder[]            @relation("OrderSalesInvoice")
  receiptAllocations  ReceiptVoucherAllocation[]
  salesReturns        SalesReturn[]              @relation("SalesReturnOriginalInvoice")
  revisions           SalesInvoiceRevision[]     @relation("SalesInvoiceRevisionInvoice")

  @@index([customerId])
  @@index([invoiceDate(sort: Desc)])
  @@index([salesRepresentativeId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                        String   @id @default(uuid()) @db.Uuid
  invoiceId                 String   @map("invoice_id") @db.Uuid
  productVariantId          String   @map("product_variant_id") @db.Uuid
  quantity                  Decimal  @db.Decimal(14, 4)
  // Custom-dimension support (nullable; matches PurchaseInvoiceLine). The
  // effective area per board = lengthM×widthM (custom) or lengthM (كبير/صغير),
  // else the variant size. metersQuantity is the authoritative total meters
  // (boards × effective area) used for the line total AND inventory posting.
  lengthM                   Decimal? @map("length_m") @db.Decimal(14, 4)
  widthM                    Decimal? @map("width_m") @db.Decimal(14, 4)
  metersQuantity            Decimal? @map("meters_quantity") @db.Decimal(14, 4)
  unitLabel                 String   @default("وحدة") @map("unit_label") @db.VarChar(30)
  unitPrice                 Decimal  @map("unit_price") @db.Decimal(14, 2)
  costPrice                 Decimal  @default(0) @map("cost_price") @db.Decimal(14, 2)
  discountPct               Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  lineTotal                 Decimal  @map("line_total") @db.Decimal(14, 2)
  lineCost                  Decimal  @default(0) @map("line_cost") @db.Decimal(14, 2)
  note                      String?  @db.VarChar(300)
  // Phase 3B — posting-time snapshots (server-stamped at confirm; COGS uses
  // product_variants.avg_cost, never the user-entered cost_price above).
  // unitCostAtPosting is the LEGACY cost PER BOARD (kept, unchanged meaning).
  unitCostAtPosting         Decimal? @map("unit_cost_at_posting") @db.Decimal(14, 2)
  // NEW canonical meter-based COGS snapshots (immutable at posting):
  //   unitCostPerMeterAtPosting = product_variants.avg_cost_per_meter at confirm
  //   lineCogsAtPosting         = metersQuantity × unitCostPerMeterAtPosting
  // Reports/reversals use lineCogsAtPosting so they reproduce the exact original
  // posting without depending on mutable product values. NULL on legacy rows.
  unitCostPerMeterAtPosting Decimal? @map("unit_cost_per_meter_at_posting") @db.Decimal(14, 4)
  lineCogsAtPosting         Decimal? @map("line_cogs_at_posting") @db.Decimal(14, 2)
  taxRateAtPosting          Decimal? @map("tax_rate_at_posting") @db.Decimal(5, 2)

  invoice        SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id])
  returnLines    SalesReturnLine[] @relation("SalesReturnLineOriginal")

  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

// ═══════════════════════════════════════════════════════════════════
// Returns (مردودات) — additive, backward-compatible. A confirmed invoice is
// an IMMUTABLE accounting document; merchandise coming back is recorded as an
// INDEPENDENT return document linked to the original invoice, never by editing
// the invoice. Square metres are the canonical commercial/inventory/costing
// quantity; board/piece counts and dimensions are operational snapshots.
// Historical prices/costs are taken from the ORIGINAL invoice line snapshots,
// never from current product prices/costs. One invoice may have many returns
// (partial or full); the invoice's return status is COMPUTED (NONE/PARTIAL/FULL)
// and never changes the invoice's own CONFIRMED status.
// ═══════════════════════════════════════════════════════════════════

model SalesReturn {
  id                      String    @id @default(uuid()) @db.Uuid
  returnNumber            BigInt    @unique @default(autoincrement()) @map("return_number")
  originalSalesInvoiceId  String    @map("original_sales_invoice_id") @db.Uuid
  customerId              String    @map("customer_id") @db.Uuid
  branchId                String    @map("branch_id") @db.Uuid
  salesRepresentativeId   String?   @map("sales_representative_id") @db.Uuid
  returnDate              DateTime  @map("return_date") @db.Date
  status                  String    @default("DRAFT") @db.VarChar(20)
  reason                  String?   @db.VarChar(300)
  notes                   String?   @db.VarChar(1000)
  // KEEP_AS_CUSTOMER_CREDIT | OFFSET_OUTSTANDING_BALANCE | CASH_REFUND | BANK_REFUND
  settlementMode          String    @default("KEEP_AS_CUSTOMER_CREDIT") @map("settlement_mode") @db.VarChar(40)
  refundTreasuryAccountId String?   @map("refund_treasury_account_id") @db.Uuid
  subtotal                Decimal   @default(0) @db.Decimal(14, 2) // returned net ex-tax
  discountTotal           Decimal   @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal                Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal              Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  cogsReversalTotal       Decimal   @default(0) @map("cogs_reversal_total") @db.Decimal(14, 2)
  journalEntryId          String?   @map("journal_entry_id") @db.Uuid
  cogsJournalEntryId      String?   @map("cogs_journal_entry_id") @db.Uuid
  customerTransactionId   String?   @map("customer_transaction_id") @db.Uuid
  salesReturnsAccountId   String?   @map("sales_returns_account_id") @db.Uuid
  confirmedAt             DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy             String?   @map("confirmed_by") @db.Uuid
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy             String?   @map("cancelled_by") @db.Uuid
  cancellationReason      String?   @map("cancellation_reason") @db.VarChar(300)
  createdBy               String    @map("created_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // journalEntryId / cogsJournalEntryId / customerTransactionId / salesReturnsAccountId
  // are intentionally unconstrained UUIDs — the SAME convention SalesInvoice uses
  // for its journal/tx/account references. Only the actor references are FK'd
  // (matching the PaymentVoucher poster/reverser convention).
  originalInvoice     SalesInvoice         @relation("SalesReturnOriginalInvoice", fields: [originalSalesInvoiceId], references: [id], onDelete: Restrict)
  customer            Customer             @relation("SalesReturnCustomer", fields: [customerId], references: [id])
  branch              Branch               @relation("SalesReturnBranch", fields: [branchId], references: [id], onDelete: Restrict)
  salesRepresentative SalesRepresentative? @relation("SalesReturnRep", fields: [salesRepresentativeId], references: [id], onDelete: Restrict)
  creator             User                 @relation("SalesReturnCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  confirmer           User?                @relation("SalesReturnConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  canceller           User?                @relation("SalesReturnCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  lines               SalesReturnLine[]

  @@index([originalSalesInvoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([salesRepresentativeId])
  @@index([status])
  @@index([returnDate(sort: Desc)])
  @@map("sales_returns")
}

model SalesReturnLine {
  id                            String   @id @default(uuid()) @db.Uuid
  salesReturnId                 String   @map("sales_return_id") @db.Uuid
  originalSalesInvoiceLineId    String   @map("original_sales_invoice_line_id") @db.Uuid
  productVariantId              String   @map("product_variant_id") @db.Uuid
  lengthM                       Decimal? @map("length_m") @db.Decimal(14, 4)
  widthM                        Decimal? @map("width_m") @db.Decimal(14, 4)
  returnedBoards                Decimal  @map("returned_boards") @db.Decimal(14, 4) // operational piece/board count
  returnedMetersQuantity        Decimal  @map("returned_meters_quantity") @db.Decimal(14, 4) // CANONICAL quantity
  originalSalePricePerMeter     Decimal  @map("original_sale_price_per_meter") @db.Decimal(14, 2)
  originalDiscountPct           Decimal  @default(0) @map("original_discount_pct") @db.Decimal(5, 2)
  originalTaxRate               Decimal  @default(0) @map("original_tax_rate") @db.Decimal(5, 2)
  returnSubtotal                Decimal  @map("return_subtotal") @db.Decimal(14, 2) // gross (metres × price)
  returnDiscount                Decimal  @default(0) @map("return_discount") @db.Decimal(14, 2)
  returnNetExTax                Decimal  @map("return_net_ex_tax") @db.Decimal(14, 2)
  returnTax                     Decimal  @default(0) @map("return_tax") @db.Decimal(14, 2)
  returnTotal                   Decimal  @map("return_total") @db.Decimal(14, 2)
  originalCostPerMeterAtPosting Decimal? @map("original_cost_per_meter_at_posting") @db.Decimal(14, 4)
  returnCogs                    Decimal  @default(0) @map("return_cogs") @db.Decimal(14, 2) // historical COGS reversed
  inventoryDisposition          String   @default("RETURN_TO_AVAILABLE_STOCK") @map("inventory_disposition") @db.VarChar(40)
  reason                        String?  @db.VarChar(300)
  note                          String?  @db.VarChar(300)

  salesReturn         SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  originalInvoiceLine SalesInvoiceLine @relation("SalesReturnLineOriginal", fields: [originalSalesInvoiceLineId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant   @relation("SalesReturnLineVariant", fields: [productVariantId], references: [id])

  @@index([salesReturnId])
  @@index([originalSalesInvoiceLineId])
  @@map("sales_return_lines")
}

model PurchaseReturn {
  id                        String    @id @default(uuid()) @db.Uuid
  returnNumber              BigInt    @unique @default(autoincrement()) @map("return_number")
  originalPurchaseInvoiceId String    @map("original_purchase_invoice_id") @db.Uuid
  supplierId                String    @map("supplier_id") @db.Uuid
  branchId                  String    @map("branch_id") @db.Uuid
  returnDate                DateTime  @map("return_date") @db.Date
  status                    String    @default("DRAFT") @db.VarChar(20)
  reason                    String?   @db.VarChar(300)
  notes                     String?   @db.VarChar(1000)
  // KEEP_AS_SUPPLIER_CREDIT | OFFSET_OUTSTANDING_BALANCE | CASH_REFUND | BANK_REFUND
  settlementMode            String    @default("KEEP_AS_SUPPLIER_CREDIT") @map("settlement_mode") @db.VarChar(40)
  refundTreasuryAccountId   String?   @map("refund_treasury_account_id") @db.Uuid
  subtotal                  Decimal   @default(0) @db.Decimal(14, 2) // returned net ex-tax
  taxTotal                  Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal                Decimal   @default(0) @map("grand_total") @db.Decimal(14, 2)
  inventoryValueOut         Decimal   @default(0) @map("inventory_value_out") @db.Decimal(14, 2)
  journalEntryId            String?   @map("journal_entry_id") @db.Uuid
  confirmedAt               DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy               String?   @map("confirmed_by") @db.Uuid
  cancelledAt               DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy               String?   @map("cancelled_by") @db.Uuid
  cancellationReason        String?   @map("cancellation_reason") @db.VarChar(300)
  createdBy                 String    @map("created_by") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // journalEntryId is an unconstrained UUID (same convention as PurchaseInvoice).
  originalInvoice PurchaseInvoice      @relation("PurchaseReturnOriginalInvoice", fields: [originalPurchaseInvoiceId], references: [id], onDelete: Restrict)
  supplier        Supplier             @relation("PurchaseReturnSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  branch          Branch               @relation("PurchaseReturnBranch", fields: [branchId], references: [id], onDelete: Restrict)
  creator         User                 @relation("PurchaseReturnCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  confirmer       User?                @relation("PurchaseReturnConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  canceller       User?                @relation("PurchaseReturnCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  lines           PurchaseReturnLine[]

  @@index([originalPurchaseInvoiceId])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([returnDate(sort: Desc)])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id                              String   @id @default(uuid()) @db.Uuid
  purchaseReturnId                String   @map("purchase_return_id") @db.Uuid
  originalPurchaseInvoiceLineId   String   @map("original_purchase_invoice_line_id") @db.Uuid
  productVariantId                String   @map("product_variant_id") @db.Uuid
  lengthM                         Decimal? @map("length_m") @db.Decimal(14, 4)
  widthM                          Decimal? @map("width_m") @db.Decimal(14, 4)
  returnedBoards                  Decimal  @map("returned_boards") @db.Decimal(14, 4)
  returnedMetersQuantity          Decimal  @map("returned_meters_quantity") @db.Decimal(14, 4)
  originalPurchasePricePerMeter   Decimal  @map("original_purchase_price_per_meter") @db.Decimal(14, 2)
  originalTaxRate                 Decimal  @default(0) @map("original_tax_rate") @db.Decimal(5, 2)
  returnNetExTax                  Decimal  @map("return_net_ex_tax") @db.Decimal(14, 2)
  returnTax                       Decimal  @default(0) @map("return_tax") @db.Decimal(14, 2)
  returnTotal                     Decimal  @map("return_total") @db.Decimal(14, 2)
  historicalInventoryCostPerMeter Decimal  @map("historical_inventory_cost_per_meter") @db.Decimal(14, 4)
  inventoryValueOut               Decimal  @map("inventory_value_out") @db.Decimal(14, 2)
  reason                          String?  @db.VarChar(300)
  note                            String?  @db.VarChar(300)

  purchaseReturn      PurchaseReturn      @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  originalInvoiceLine PurchaseInvoiceLine @relation("PurchaseReturnLineOriginal", fields: [originalPurchaseInvoiceLineId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant      @relation("PurchaseReturnLineVariant", fields: [productVariantId], references: [id])

  @@index([purchaseReturnId])
  @@index([originalPurchaseInvoiceLineId])
  @@map("purchase_return_lines")
}

// ═══════════════════════════════════════════════════════════════════
// Phase 2 accounting foundation — new models (additive)
// ═══════════════════════════════════════════════════════════════════

