  branch               Branch                     @relation("PaymentVoucherBranch", fields: [branchId], references: [id], onDelete: Restrict)
  supplier             Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasuryAccount      Account                    @relation("PaymentVoucherTreasury", fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  period               FinancialPeriod?           @relation(fields: [periodId], references: [id])
  journalEntry         JournalEntry?              @relation("PaymentVoucherJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntry JournalEntry?              @relation("PaymentVoucherReversalJournal", fields: [reversalJournalEntryId], references: [id])
  creator              User                       @relation("PaymentVoucherCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  poster               User?                      @relation("PaymentVoucherPostedBy", fields: [postedBy], references: [id])
  reverser             User?                      @relation("PaymentVoucherReversedBy", fields: [reversedBy], references: [id])
  allocations          PaymentVoucherAllocation[]

  @@index([supplierId])
  @@index([treasuryAccountId])
  @@index([status])
  @@index([periodId])
  @@index([branchId, voucherDate(sort: Desc)])
  @@map("payment_vouchers")
}

model ReceiptVoucherAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  receiptVoucherId String   @map("receipt_voucher_id") @db.Uuid
  salesInvoiceId   String   @map("sales_invoice_id") @db.Uuid
  amount           Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receiptVoucher ReceiptVoucher @relation(fields: [receiptVoucherId], references: [id], onDelete: Cascade)
  salesInvoice   SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptVoucherId, salesInvoiceId])
  @@index([receiptVoucherId])
  @@index([salesInvoiceId])
  @@map("receipt_voucher_allocations")
}

model PaymentVoucherAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  paymentVoucherId  String   @map("payment_voucher_id") @db.Uuid
  purchaseInvoiceId String   @map("purchase_invoice_id") @db.Uuid
  amount            Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentVoucher  PaymentVoucher  @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentVoucherId, purchaseInvoiceId])
  @@index([paymentVoucherId])
  @@index([purchaseInvoiceId])
  @@map("payment_voucher_allocations")
}

// =========================== Treasury ================================
// Multi-treasury management layer. A Treasury is a thin, branch-scoped wrapper
// over exactly one cash/bank GL Account (glAccountId, 1:1). The GL account
// remains the accounting anchor — every balance is derived from posted
// journal_lines on that account (see TreasuryGuardService), never from a
// mutable field here. Existing cash/bank accounts (incl. the main treasury)
// are backfilled with a Treasury row by the additive migration.

model Treasury {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(30)
  nameAr               String   @map("name_ar") @db.VarChar(160)
  nameEn               String?  @map("name_en") @db.VarChar(160)
  branchId             String   @map("branch_id") @db.Uuid
  glAccountId          String   @unique @map("gl_account_id") @db.Uuid
  currencyCode         String   @default("EGP") @map("currency_code") @db.VarChar(3)
  allowNegativeBalance Boolean  @default(false) @map("allow_negative_balance")
  isDefault            Boolean  @default(false) @map("is_default")
  active               Boolean  @default(true)
  notes                String?  @db.VarChar(500)
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  glAccount    Account            @relation("TreasuryGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  creator      User               @relation("TreasuryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  transfersOut TreasuryTransfer[] @relation("TransferSource")
  transfersIn  TreasuryTransfer[] @relation("TransferDestination")

  @@index([branchId])
  @@index([active])
  @@map("treasuries")
}

// ======================= TreasuryTransfer ============================
// Money moved between two treasuries. Confirmation posts a single balanced
// journal (Dr destination GL / Cr source GL) through the PostingEngine;
// cancellation posts a reversing journal (never edits/deletes history).

model TreasuryTransfer {
  id                     String         @id @default(uuid()) @db.Uuid
  transferNumber         BigInt         @unique @default(autoincrement()) @map("transfer_number")
  transferDate           DateTime       @map("transfer_date") @db.Date
  sourceTreasuryId       String         @map("source_treasury_id") @db.Uuid
  destinationTreasuryId  String         @map("destination_treasury_id") @db.Uuid
  amount                 Decimal        @db.Decimal(18, 2)
  reference              String?        @db.VarChar(100)
  notes                  String?        @db.VarChar(300)
  status                 TransferStatus @default(DRAFT)
  periodId               String?        @map("period_id") @db.Uuid
  journalEntryId         String?        @unique @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?        @unique @map("reversal_journal_entry_id") @db.Uuid
  createdBy              String         @map("created_by") @db.Uuid
  confirmedBy            String?        @map("confirmed_by") @db.Uuid
  cancelledBy            String?        @map("cancelled_by") @db.Uuid
  confirmedAt            DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  source               Treasury         @relation("TransferSource", fields: [sourceTreasuryId], references: [id], onDelete: Restrict)
  destination          Treasury         @relation("TransferDestination", fields: [destinationTreasuryId], references: [id], onDelete: Restrict)
  period               FinancialPeriod? @relation(fields: [periodId], references: [id])
  journalEntry         JournalEntry?    @relation("TransferJournal", fields: [journalEntryId], references: [id])
  reversalJournalEntry JournalEntry?    @relation("TransferReversalJournal", fields: [reversalJournalEntryId], references: [id])
  creator              User             @relation("TransferCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  confirmer            User?            @relation("TransferConfirmedBy", fields: [confirmedBy], references: [id])
  canceller            User?            @relation("TransferCancelledBy", fields: [cancelledBy], references: [id])

  @@index([sourceTreasuryId])
  @@index([destinationTreasuryId])
  @@index([status])
  @@map("treasury_transfers")
}

// ====================== Cutover import provenance =====================
// Additive-only. Records WHAT an opening-data import run did, so a repeated
// execute can be refused and every created row traced back to its approved
// source row. Never stores source documents, customer names or balances.

model CutoverImportBatch {
  id              String    @id @default(uuid()) @db.Uuid
  manifestId      String    @map("manifest_id") @db.VarChar(120)
  manifestHash    String    @map("manifest_hash") @db.VarChar(64)
  sourceHashes    Json      @map("source_hashes")
  mode            String    @db.VarChar(20) // AUDIT | DRY_RUN | EXECUTE
  scope           String    @db.VarChar(40) // FULL_OPENING_IMPORT | MASTER_AND_STOCK_ONLY | AUDIT_ONLY
  status          String    @db.VarChar(20) // RUNNING | COMPLETED | FAILED
  operator        String    @db.VarChar(120)
  approver        String    @db.VarChar(120)
  approvalDate    DateTime  @map("approval_date") @db.Date
  cutoverDate     DateTime  @map("cutover_date") @db.Date
  branchId        String    @map("branch_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  failureCode     String?   @map("failure_code") @db.VarChar(80)
  failureReason   String?   @map("failure_reason") @db.VarChar(500)
  reconciliation  Json?
  codeRevision    String?   @map("code_revision") @db.VarChar(60)
  importerVersion String    @map("importer_version") @db.VarChar(20)

  branch Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rows   CutoverImportRow[]

  // One committed EXECUTE per manifest hash + scope. DRY_RUN never commits, so
  // it can never occupy this slot.
  @@unique([manifestHash, scope, mode])
  @@index([status])
  @@map("cutover_import_batches")
}

model CutoverImportRow {
  id              String   @id @default(uuid()) @db.Uuid
  batchId         String   @map("batch_id") @db.Uuid
  sourceKey       String   @map("source_key") @db.VarChar(160)
  decisionId      String   @map("decision_id") @db.VarChar(60)
  entityType      String   @map("entity_type") @db.VarChar(40)
  entityId        String?  @map("entity_id") @db.Uuid
  action          String   @db.VarChar(30) // CREATED | REUSED | SKIPPED_ZERO_QTY | EXCLUDED
  sourceReference String   @map("source_reference") @db.VarChar(160)
  approvedKey     String   @map("approved_key") @db.VarChar(160)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch CutoverImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceKey])
  @@index([entityType, entityId])
  @@map("cutover_import_rows")
}

// ─────────────────────────────────────────────────────────────────────────────
// HISTORICAL SALES-RETURN ARCHIVE — pre-cutover (July 2026) paper returns.
//
// These are NOT documents. They are a faithful record of what six July source
// rows said, kept so the business can see its return history in the Returns
// screen. Their financial and stock effect is ALREADY inside the approved
// 2026-08-01 opening balances and the 2026-08-01 physical count, so posting
// them again would double-count the customer balance and the inventory.
//
// The contract is the ABSENCE of posting: there is deliberately no
// journalEntryId, no customerTransactionId, no inventory linkage, no status
// lifecycle and no confirm/cancel. The module that serves these tables imports
// neither PostingModule nor InventoryModule, and a test asserts that.
//
// Rows are written once by a one-time importer and never change: there is no
// updatedAt and no write API. A repeat import is refused by sourceFingerprint.
// ─────────────────────────────────────────────────────────────────────────────
model HistoricalReturnImportBatch {
  id              String    @id @default(uuid()) @db.Uuid
  batchKey        String    @unique @map("batch_key") @db.VarChar(120)
  sourceSystem    String    @map("source_system") @db.VarChar(120)
  sourceFileHash  String    @map("source_file_hash") @db.VarChar(64)
  sourceSheet     String    @map("source_sheet") @db.VarChar(120)
  expectedRows    Int       @map("expected_rows")
  importedRows    Int       @default(0) @map("imported_rows")
  status          String    @db.VarChar(20) // RUNNING | COMPLETED | FAILED
  operator        String    @db.VarChar(120)
  approver        String    @db.VarChar(120)
  approvalDate    DateTime  @map("approval_date") @db.Date
  reconciliation  Json?
  codeRevision    String?   @map("code_revision") @db.VarChar(60)
  importerVersion String    @map("importer_version") @db.VarChar(20)
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)

  archives HistoricalSalesReturnArchive[]

  @@index([status])
  @@map("historical_return_import_batches")
}

model HistoricalSalesReturnArchive {
  id                       String   @id @default(uuid()) @db.Uuid
  archiveNumber            BigInt   @unique @default(autoincrement()) @map("archive_number")
  /// sha256 of the canonical source row. The duplicate gate: a second import
  /// of the same row is refused by this constraint, not by application luck.
  sourceFingerprint        String   @unique @map("source_fingerprint") @db.VarChar(64)
  importBatchId            String   @map("import_batch_id") @db.Uuid
  sourceSystem             String   @map("source_system") @db.VarChar(120)
  sourceFileHash           String   @map("source_file_hash") @db.VarChar(64)
  sourceSheet              String   @map("source_sheet") @db.VarChar(120)
  sourceRow                Int      @map("source_row")
  sourceReference          String   @map("source_reference") @db.VarChar(160)
  documentDate             DateTime @map("document_date") @db.Date
  /// Set only when the source name resolves to exactly one customer. Left null
  /// rather than guessed — the snapshot below always carries what the source said.
  customerId               String?  @map("customer_id") @db.Uuid
  customerSourceReference  String   @map("customer_source_reference") @db.VarChar(200)
  /// The July invoice number as written on the paper, when the source had one.
  /// Never invented: the source recorded no invoice number for these six rows.
  originalInvoiceReference String?  @map("original_invoice_reference") @db.VarChar(120)
  grossValue               Decimal  @map("gross_value") @db.Decimal(14, 2)
  notes                    String?  @db.VarChar(1000)
  immutable                Boolean  @default(true)
  importedBy               String   @map("imported_by") @db.Uuid
  importedAt               DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch    HistoricalReturnImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  customer Customer?                          @relation("HistoricalArchiveCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  importer User                               @relation("HistoricalArchiveImportedBy", fields: [importedBy], references: [id], onDelete: Restrict)
  lines    HistoricalSalesReturnArchiveLine[]

  @@index([importBatchId])
  @@index([customerId])
  @@index([documentDate(sort: Desc)])
  @@map("historical_sales_return_archives")
}

model HistoricalSalesReturnArchiveLine {
  id                 String   @id @default(uuid()) @db.Uuid
  historicalReturnId String   @map("historical_return_id") @db.Uuid
  lineNumber         Int      @map("line_number")
  /// Set only on an exact code + exact board-size match; never a partial code.
  productVariantId   String?  @map("product_variant_id") @db.Uuid
  productSourceCode  String   @map("product_source_code") @db.VarChar(60)
  boards             Decimal  @db.Decimal(14, 4)
  /// boards x board size — the same canonical rule the rest of the system uses.
  canonicalMeters    Decimal  @map("canonical_meters") @db.Decimal(14, 4)
  unitPrice          Decimal? @map("unit_price") @db.Decimal(14, 2)
  lineValue          Decimal  @map("line_value") @db.Decimal(14, 2)
  sourceReference    String   @map("source_reference") @db.VarChar(160)

  archive        HistoricalSalesReturnArchive @relation(fields: [historicalReturnId], references: [id], onDelete: Cascade)
  productVariant ProductVariant?              @relation("HistoricalArchiveLineVariant", fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([historicalReturnId, lineNumber])
  @@index([historicalReturnId])
  @@index([productVariantId])
  @@map("historical_sales_return_archive_lines")
}

// ═══════════════════════════════════════════════════════════════════
// Confirmed-invoice revision (P7) — additive, backwards compatible.
//
// A confirmed invoice stays a posted accounting document. It is NEVER edited
// in place accounting-wise: a revision REVERSES the currently effective
// version, REPOSTS the revised one, and keeps an immutable record of both.
// The invoice number never changes and the status stays CONFIRMED; only
// revision_number advances (1 = the original confirmation).
//
// Every original journal, movement and party transaction is retained. The
// revision row is the audit spine linking the reversal effects, the
// replacement effects and, for purchases, the valuation-adjustment journals.
// ═══════════════════════════════════════════════════════════════════

enum InvoiceRevisionStatus {
  /// Calculated but never written — a preview commits nothing, so this value
  /// exists for the response contract and never appears in the table.
  PREVIEWED
  /// The only status a persisted row can hold: the whole revision committed.
  POSTED
  /// A failed revision rolls its transaction back, so this never persists
  /// either; it is kept so a future durable-attempt log has a home.
  FAILED
}

model SalesInvoiceRevision {
  id                            String                @id @default(uuid()) @db.Uuid
  salesInvoiceId                String                @map("sales_invoice_id") @db.Uuid
  /// The revision this row PRODUCED (2, 3, …). Revision 1 is the original.
  revisionNumber                Int                   @map("revision_number")
  /// Optimistic-concurrency anchor: the revision the actor believed was current.
  previousRevisionNumber        Int                   @map("previous_revision_number")
  reason                        String                @db.VarChar(500)
  status                        InvoiceRevisionStatus @default(POSTED)
  originalInvoiceStatus         String                @map("original_invoice_status") @db.VarChar(20)
  resultingInvoiceStatus        String                @map("resulting_invoice_status") @db.VarChar(20)
  /// Commercial dates, preserved exactly as the documents carry them …
  previousDocumentDate          DateTime              @map("previous_document_date") @db.Date
  documentDate                  DateTime              @map("document_date") @db.Date
  /// … and the accounting date the reversal/replacement actually posted on,
  /// which differs whenever the document date falls in a closed/absent period.
  postingDate                   DateTime              @map("posting_date") @db.Date
  crossesClosedPeriod           Boolean               @default(false) @map("crosses_closed_period")
  /// Structured, Decimal-safe snapshots — enough to rebuild and display the
  /// exact version. Never contains credentials, tokens or unrelated user data.
  beforeSnapshot                Json                  @map("before_snapshot")
  afterSnapshot                 Json                  @map("after_snapshot")
  /// Calculated effects: line diff, stock diff, party impact, journals, replay.
  delta                         Json
  beforeFingerprint             String                @map("before_fingerprint") @db.VarChar(64)
  afterFingerprint              String                @map("after_fingerprint") @db.VarChar(64)
  previewFingerprint            String                @map("preview_fingerprint") @db.VarChar(64)
  idempotencyKey                String                @map("idempotency_key") @db.VarChar(120)
  reversalJournalEntryId        String?               @map("reversal_journal_entry_id") @db.Uuid
  reversalCogsJournalEntryId    String?               @map("reversal_cogs_journal_entry_id") @db.Uuid
  replacementJournalEntryId     String?               @map("replacement_journal_entry_id") @db.Uuid
  replacementCogsJournalEntryId String?               @map("replacement_cogs_journal_entry_id") @db.Uuid
  /// String[] of journal ids; empty when the revision needed no revaluation.
  valuationJournalEntryIds      Json                  @map("valuation_journal_entry_ids")
  reversalMovementIds           Json                  @map("reversal_movement_ids")
  replacementMovementIds        Json                  @map("replacement_movement_ids")
  reversalPartyTxIds            Json                  @map("reversal_party_tx_ids")
  replacementPartyTxIds         Json                  @map("replacement_party_tx_ids")
  revisedBy                     String                @map("revised_by") @db.Uuid
  createdAt                     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice SalesInvoice @relation("SalesInvoiceRevisionInvoice", fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  actor   User         @relation("SalesInvoiceRevisionActor", fields: [revisedBy], references: [id], onDelete: Restrict)

  @@unique([salesInvoiceId, revisionNumber])
  @@unique([salesInvoiceId, idempotencyKey])
  @@unique([idempotencyKey])
  @@index([salesInvoiceId])
  @@index([status])
  @@index([revisedBy, createdAt(sort: Desc)])
  @@map("sales_invoice_revisions")
}

model PurchaseInvoiceRevision {
  id                        String                @id @default(uuid()) @db.Uuid
  purchaseInvoiceId         String                @map("purchase_invoice_id") @db.Uuid
  revisionNumber            Int                   @map("revision_number")
  previousRevisionNumber    Int                   @map("previous_revision_number")
  reason                    String                @db.VarChar(500)
  status                    InvoiceRevisionStatus @default(POSTED)
  originalInvoiceStatus     String                @map("original_invoice_status") @db.VarChar(20)
  resultingInvoiceStatus    String                @map("resulting_invoice_status") @db.VarChar(20)
  previousDocumentDate      DateTime              @map("previous_document_date") @db.Date
  documentDate              DateTime              @map("document_date") @db.Date
  postingDate               DateTime              @map("posting_date") @db.Date
  crossesClosedPeriod       Boolean               @default(false) @map("crosses_closed_period")
  beforeSnapshot            Json                  @map("before_snapshot")
  afterSnapshot             Json                  @map("after_snapshot")
  delta                     Json
  beforeFingerprint         String                @map("before_fingerprint") @db.VarChar(64)
  afterFingerprint          String                @map("after_fingerprint") @db.VarChar(64)
  previewFingerprint        String                @map("preview_fingerprint") @db.VarChar(64)
  idempotencyKey            String                @map("idempotency_key") @db.VarChar(120)
  reversalJournalEntryId    String?               @map("reversal_journal_entry_id") @db.Uuid
  replacementJournalEntryId String?               @map("replacement_journal_entry_id") @db.Uuid
  valuationJournalEntryIds  Json                  @map("valuation_journal_entry_ids")
  reversalMovementIds       Json                  @map("reversal_movement_ids")
  replacementMovementIds    Json                  @map("replacement_movement_ids")
  reversalPartyTxIds        Json                  @map("reversal_party_tx_ids")
  replacementPartyTxIds     Json                  @map("replacement_party_tx_ids")
  revisedBy                 String                @map("revised_by") @db.Uuid
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice PurchaseInvoice @relation("PurchaseInvoiceRevisionInvoice", fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  actor   User            @relation("PurchaseInvoiceRevisionActor", fields: [revisedBy], references: [id], onDelete: Restrict)

  @@unique([purchaseInvoiceId, revisionNumber])
  @@unique([purchaseInvoiceId, idempotencyKey])
  @@unique([idempotencyKey])
  @@index([purchaseInvoiceId])
  @@index([status])
  @@index([revisedBy, createdAt(sort: Desc)])
  @@map("purchase_invoice_revisions")
}

// ═══════════════════════════════════════════════════════════════════
// Inventory transfer (P9) — additive, backwards compatible.
//
// Moving stock between two branches of the SAME company is a redistribution,
// not a trade. It therefore changes WHERE the stock sits and nothing else: the
// company's total boards, total metres and total inventory value are identical
// before and after, and the shared per-variant WAC is untouched. Because the
// chart of accounts uses ONE inventory control account rather than a per-branch
// account, there is no ledger entry to make — the same precedent inventory
// counts and adjustments already set.
//
// Only complete boards move. Metres are always derived server-side as
// boards × the variant's own sizeMetersPerBoard, never entered by a user.
// ═══════════════════════════════════════════════════════════════════

enum InventoryTransferStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model InventoryTransfer {
  id                         String                  @id @default(uuid()) @db.Uuid
  /// Allocated by the database when the DRAFT row is inserted, so a preview —
  /// which inserts nothing — can never consume one. Rendered as TRF-000001.
  transferNumber             BigInt                  @unique @default(autoincrement()) @map("transfer_number")
  status                     InventoryTransferStatus @default(DRAFT)
  transferDate               DateTime                @map("transfer_date") @db.Date
  sourceBranchId             String                  @map("source_branch_id") @db.Uuid
  destinationBranchId        String                  @map("destination_branch_id") @db.Uuid
  purpose                    String?                 @db.VarChar(300)
  notes                      String?                 @db.VarChar(1000)
  /// Optimistic concurrency: every draft edit and every status change bumps it,
  /// and confirm/cancel refuse a request carrying a stale value.
  version                    Int                     @default(1)
  confirmationIdempotencyKey String?                 @unique @map("confirmation_idempotency_key") @db.VarChar(120)
  cancellationIdempotencyKey String?                 @unique @map("cancellation_idempotency_key") @db.VarChar(120)
  confirmationFingerprint    String?                 @map("confirmation_fingerprint") @db.VarChar(64)
  cancellationFingerprint    String?                 @map("cancellation_fingerprint") @db.VarChar(64)
  createdById                String                  @map("created_by_id") @db.Uuid
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById                String?                 @map("updated_by_id") @db.Uuid
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedById              String?                 @map("confirmed_by_id") @db.Uuid
  confirmedAt                DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  cancelledById              String?                 @map("cancelled_by_id") @db.Uuid
  cancelledAt                DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason         String?                 @map("cancellation_reason") @db.VarChar(500)

  sourceBranch      Branch                  @relation("InventoryTransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch Branch                  @relation("InventoryTransferDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  creator           User                    @relation("InventoryTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updater           User?                   @relation("InventoryTransferUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  confirmer         User?                   @relation("InventoryTransferConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  canceller         User?                   @relation("InventoryTransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines             InventoryTransferLine[]

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@index([transferDate(sort: Desc)])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                          String   @id @default(uuid()) @db.Uuid
  transferId                  String   @map("transfer_id") @db.Uuid
  productVariantId            String   @map("product_variant_id") @db.Uuid
  /// Snapshots taken when the line is written, so the document still reads
  /// correctly after the product master is renamed or re-sized later.
  skuCode                     String   @map("sku_code") @db.VarChar(60)
  productNameAr               String   @map("product_name_ar") @db.VarChar(200)
  productNameEn               String?  @map("product_name_en") @db.VarChar(200)
  boardSizeMeters             Decimal  @map("board_size_meters") @db.Decimal(10, 4)
  /// Whole boards only — the CHECK below refuses a fraction at the database.
  boardQuantity               Decimal  @map("board_quantity") @db.Decimal(14, 4)
  /// Always boards × boardSizeMeters, computed by the server.
  meterQuantity               Decimal  @map("meter_quantity") @db.Decimal(14, 4)
  /// The shared WAC at the moment of confirmation. Carried, never changed.
  costPerMeter                Decimal  @default(0) @map("cost_per_meter") @db.Decimal(14, 4)
  totalValue                  Decimal  @default(0) @map("total_value") @db.Decimal(14, 2)
  lineIndex                   Int      @map("line_index")
  /// The four movements this line produced. Holding them here keeps the pairing
  /// relational without adding columns to the hot inventory_movements table.
  sourceMovementId            String?  @map("source_movement_id") @db.Uuid
  destinationMovementId       String?  @map("destination_movement_id") @db.Uuid
  cancelSourceMovementId      String?  @map("cancel_source_movement_id") @db.Uuid
  cancelDestinationMovementId String?  @map("cancel_destination_movement_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transfer       InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([transferId, productVariantId])
  @@unique([transferId, lineIndex])
  @@index([transferId])
  @@index([productVariantId])
  @@map("inventory_transfer_lines")
}
