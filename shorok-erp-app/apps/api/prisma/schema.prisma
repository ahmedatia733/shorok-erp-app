// ============================== Account ==============================

model Account {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique @db.VarChar(20)
  nameAr       String             @map("name_ar") @db.VarChar(160)
  nameEn       String             @map("name_en") @db.VarChar(160)
  category     AccountCategory
  accountType  AccountType        @map("account_type")
  parentId     String?            @map("parent_id") @db.Uuid
  isLeaf       Boolean            @default(true) @map("is_leaf")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  // Phase 2 accounting foundation (additive)
  isCashOrBank Boolean            @default(false) @map("is_cash_or_bank")
  treasuryType TreasuryType?      @map("treasury_type")
  bankMeta     Json?              @map("bank_meta")
  systemRole   AccountSystemRole? @unique @map("system_role")

  parent                  Account?              @relation("AccountChildren", fields: [parentId], references: [id])
  children                Account[]             @relation("AccountChildren")
  journalLines            JournalLine[]
  templateLines           JournalTemplateLine[]
  fixedAssetsAsAsset      FixedAsset[]          @relation("AssetAccount")
  fixedAssetsAsAccumDep   FixedAsset[]          @relation("AccumulatedDepAccount")
  fixedAssetsAsDepExpense FixedAsset[]          @relation("DepreciationExpenseAccount")
  expensesAsGl            Expense[]             @relation("ExpenseGlAccount")
  expensesAsPaymentGl     Expense[]             @relation("ExpensePaymentGlAccount")
  collectionsAsCash       OrderCollection[]     @relation("CollectionCashAccount")
  collectionsAsAr         OrderCollection[]     @relation("CollectionArAccount")
  factoryEntriesAsDebit   FactoryLedgerEntry[]  @relation("FactoryEntryDebitAccount")
  factoryEntriesAsCredit  FactoryLedgerEntry[]  @relation("FactoryEntryCreditAccount")
  receiptVoucherTreasury  ReceiptVoucher[]      @relation("ReceiptVoucherTreasury")
  paymentVoucherTreasury  PaymentVoucher[]      @relation("PaymentVoucherTreasury")
  treasury                Treasury?             @relation("TreasuryGlAccount")

  @@index([category])
  @@index([parentId])
  @@map("accounts")
}

// =========================== JournalEntry ============================

model JournalEntry {
  id                    String             @id @default(uuid()) @db.Uuid
  entryNumber           BigInt             @unique @default(autoincrement()) @map("entry_number")
  entryType             String             @default("JOURNAL") @map("entry_type") @db.VarChar(30)
  reference             String?            @map("reference") @db.VarChar(100)
  entryDate             DateTime           @map("entry_date") @db.Date
  description           String             @db.VarChar(500)
  referenceType         String?            @map("reference_type") @db.VarChar(60)
  referenceId           String?            @map("reference_id") @db.Uuid
  createdBy             String             @map("created_by") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  // Phase 2 accounting foundation (additive; nullable/defaulted for legacy writers)
  status                JournalEntryStatus @default(POSTED)
  periodId              String?            @map("period_id") @db.Uuid
  reversalOfId          String?            @map("reversal_of_id") @db.Uuid
  sourceType            JournalSourceType? @map("source_type")
  sourceId              String?            @map("source_id") @db.Uuid
  idempotencyKey        String?            @unique @map("idempotency_key") @db.VarChar(120)
  // Optional document-level rep attribution (e.g. from the source invoice).
  // NOT used for the rep balance — that comes from journal_lines only.
  salesRepresentativeId String?            @map("sales_representative_id") @db.Uuid

  creator                  User                 @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id])
  salesRepresentative      SalesRepresentative? @relation(fields: [salesRepresentativeId], references: [id], onDelete: Restrict)
  lines                    JournalLine[]
  expenses                 Expense[]
  collections              OrderCollection[]    @relation("CollectionJournalEntry")
  factoryEntries           FactoryLedgerEntry[] @relation("FactoryEntryJournal")
  period                   FinancialPeriod?     @relation(fields: [periodId], references: [id])
  reversalOf               JournalEntry?        @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy               JournalEntry[]       @relation("JournalEntryReversal")
  receiptVoucher           ReceiptVoucher?      @relation("ReceiptVoucherJournal")
  receiptVoucherReversal   ReceiptVoucher?      @relation("ReceiptVoucherReversalJournal")
  paymentVoucher           PaymentVoucher?      @relation("PaymentVoucherJournal")
  paymentVoucherReversal   PaymentVoucher?      @relation("PaymentVoucherReversalJournal")
  treasuryTransfer         TreasuryTransfer?    @relation("TransferJournal")
  treasuryTransferReversal TreasuryTransfer?    @relation("TransferReversalJournal")

  @@index([entryDate(sort: Desc)])
  @@index([periodId])
  @@index([sourceType, sourceId])
  @@index([salesRepresentativeId])
  @@map("journal_entries")
}

// =========================== JournalLine =============================

model JournalLine {
  id                    String            @id @default(uuid()) @db.Uuid
  journalEntryId        String            @map("journal_entry_id") @db.Uuid
  accountId             String            @map("account_id") @db.Uuid
  debit                 Decimal           @default(0) @db.Decimal(14, 2)
  credit                Decimal           @default(0) @db.Decimal(14, 2)
  note                  String?           @db.VarChar(300)
  // Phase 2 party/branch dimensions (additive; nullable for legacy writers)
  partyType             JournalPartyType? @map("party_type")
  partyId               String?           @map("party_id") @db.Uuid
  branchId              String?           @map("branch_id") @db.Uuid
  // Authoritative rep dimension: debit/credit live at the line, so the rep
  // balance is computed from these. Separate from partyType/partyId/accountId.
  salesRepresentativeId String?           @map("sales_representative_id") @db.Uuid

  journalEntry        JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account             Account              @relation(fields: [accountId], references: [id])
  salesRepresentative SalesRepresentative? @relation(fields: [salesRepresentativeId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, partyType, partyId])
  @@index([salesRepresentativeId])
  @@map("journal_lines")
}

// ========================= PurchaseInvoice ===========================

model PurchaseInvoice {
