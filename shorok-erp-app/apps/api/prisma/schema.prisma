// Shorok ERP — Prisma schema
// Authoritative reference: ../specs/main/data-model.md
//
// All money columns are NUMERIC(14,2). Quantities are NUMERIC(14,4).
// Append-only tables (audit_logs, inventory_movements, order_collections,
// factory_ledger_entries) are protected by REVOKE UPDATE/DELETE in a
// follow-up migration. Non-negative inventory invariant is backed by a
// CHECK constraint also added in a follow-up migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================== Enums ===============================

enum Role {
  OWNER
  BRANCH_MANAGER
  WAREHOUSE
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductCategory {
  NORMAL
  SPECIAL
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  COUNT_CORRECTION
  SALE_RETURN
  PURCHASE_RETURN
  /// Stock left this branch on an internal transfer. A cancellation reuses the
  /// same pair in the opposite direction, distinguished by reference_type, which
  /// is the convention returns already follow (sales_return vs
  /// sales_return_cancel) — so no separate CANCEL member is needed.
  TRANSFER_OUT
  /// Stock arrived at this branch on an internal transfer.
  TRANSFER_IN
}

enum OrderStatus {
  DRAFT
  PENDING_PRICE_APPROVAL
  CONFIRMED
  PARTIALLY_COLLECTED
  PAID
  CANCELLED
}

enum PriceOverrideStatus {
  WITHIN_TOLERANCE
  PENDING_APPROVAL
  APPROVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CONFIRM
  CANCEL
  APPROVE
  COLLECT
  IMPORT
  LOGIN
  LOGOUT
}

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  EXPENSE
}

enum AccountType {
  FIXED_ASSET
  CURRENT_ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  EXPENSE
}

// ── Phase 2 accounting-foundation enums ──────────────────────────────
enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum TreasuryType {
  CASH
  BANK
}

enum AccountSystemRole {
  AR_CONTROL
  AP_CONTROL
  VAT_INPUT
  VAT_OUTPUT
  INVENTORY
  COGS
  REVENUE
  DISCOUNT
  ROUNDING
  RETAINED_EARNINGS
  OPENING_EQUITY
  SHRINKAGE
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

// Phase 3D: expense lifecycle. RECORDED = legacy/record-only (no GL entry);
// POSTED = has a GL entry; REVERSED = GL entry reversed, row retained.
enum ExpenseStatus {
  RECORDED
  POSTED
  REVERSED
}

// Phase 4B: receipt/payment voucher lifecycle. DRAFT (no GL yet) → POSTED
// (journal via engine) → REVERSED (mirror entry; original link retained).
enum VoucherStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransferStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum JournalSourceType {
  SALES_INVOICE
  PURCHASE_INVOICE
  SALES_RETURN
  PURCHASE_RETURN
  RECEIPT_VOUCHER
  PAYMENT_VOUCHER
  EXPENSE
  ADJUSTMENT
  DEPRECIATION
  OPENING
  MANUAL
  TREASURY_TRANSFER
  TREASURY_OPENING
}

enum JournalPartyType {
  CUSTOMER
  SUPPLIER
}

enum TaxRegistrationStatus {
  REGISTERED
  NOT_REGISTERED
}

enum TaxFilingCycle {
  MONTHLY
  QUARTERLY
}

enum PrintBrandingPolicy {
  CURRENT
  AS_POSTED
}

enum PaperSize {
  A4
  A5_LANDSCAPE
}

enum CostingMethod {
  WAC
}

// =============================== Branch ==============================

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String   @unique @map("name_ar") @db.VarChar(120)
  nameEn    String   @unique @map("name_en") @db.VarChar(120)
  location  String?  @db.VarChar(240)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userAccesses       UserBranchAccess[]
  inventoryBalances  BranchInventoryBalance[]
  inventoryMovements InventoryMovement[]
  customerOrders     CustomerOrder[]
  expenses           Expense[]
  purchaseInvoices   PurchaseInvoice[]        @relation("PurchaseInvoiceBranch")
  salesInvoices      SalesInvoice[]           @relation("SalesInvoiceBranch")
  receiptVouchers    ReceiptVoucher[]         @relation("ReceiptVoucherBranch")
  paymentVouchers    PaymentVoucher[]         @relation("PaymentVoucherBranch")
  salesReturns       SalesReturn[]            @relation("SalesReturnBranch")
  purchaseReturns    PurchaseReturn[]         @relation("PurchaseReturnBranch")
  treasuries         Treasury[]
  transfersOutgoing  InventoryTransfer[]      @relation("InventoryTransferSource")
  transfersIncoming  InventoryTransfer[]      @relation("InventoryTransferDestination")

  cutoverImportBatches CutoverImportBatch[]

  @@map("branches")
}

// ================================ User ===============================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  phone        String     @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(160)
  passwordHash String     @map("password_hash") @db.VarChar(120)
  role         Role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  branchAccesses              UserBranchAccess[]
  refreshTokens               RefreshToken[]
  inventoryWrites             InventoryMovement[]       @relation("InventoryMovementCreatedBy")
  ordersCreated               CustomerOrder[]           @relation("CustomerOrderCreatedBy")
  pricesApproved              CustomerOrder[]           @relation("CustomerOrderPriceApprovedBy")
  collectionsCreated          OrderCollection[]
  expensesCreated             Expense[]
  factoryEntries              FactoryLedgerEntry[]
  auditLogs                   AuditLog[]
  journalEntries              JournalEntry[]            @relation("JournalEntryCreatedBy")
  purchaseInvoicesCreated     PurchaseInvoice[]         @relation("PurchaseInvoiceCreatedBy")
  salesInvoicesCreated        SalesInvoice[]            @relation("SalesInvoiceCreatedBy")
  salesInvoiceRevisions       SalesInvoiceRevision[]    @relation("SalesInvoiceRevisionActor")
  purchaseInvoiceRevisions    PurchaseInvoiceRevision[] @relation("PurchaseInvoiceRevisionActor")
  inventoryTransfersCreated   InventoryTransfer[]       @relation("InventoryTransferCreatedBy")
  inventoryTransfersUpdated   InventoryTransfer[]       @relation("InventoryTransferUpdatedBy")
  inventoryTransfersConfirmed InventoryTransfer[]       @relation("InventoryTransferConfirmedBy")
  inventoryTransfersCancelled InventoryTransfer[]       @relation("InventoryTransferCancelledBy")
  payments                    Payment[]
  journalTemplates            JournalTemplate[]
  customerTransactions        CustomerTransaction[]
  fixedAssets                 FixedAsset[]              @relation("FixedAssetCreatedBy")
  depreciationEntries         DepreciationEntry[]       @relation("DepreciationEntryCreatedBy")
  receiptVouchersCreated      ReceiptVoucher[]          @relation("ReceiptVoucherCreatedBy")
  receiptVouchersPosted       ReceiptVoucher[]          @relation("ReceiptVoucherPostedBy")
  receiptVouchersReversed     ReceiptVoucher[]          @relation("ReceiptVoucherReversedBy")
  paymentVouchersCreated      PaymentVoucher[]          @relation("PaymentVoucherCreatedBy")
  paymentVouchersPosted       PaymentVoucher[]          @relation("PaymentVoucherPostedBy")
  paymentVouchersReversed     PaymentVoucher[]          @relation("PaymentVoucherReversedBy")
  salesReturnsCreated         SalesReturn[]             @relation("SalesReturnCreatedBy")
  salesReturnsConfirmed       SalesReturn[]             @relation("SalesReturnConfirmedBy")
  salesReturnsCancelled       SalesReturn[]             @relation("SalesReturnCancelledBy")
  purchaseReturnsCreated      PurchaseReturn[]          @relation("PurchaseReturnCreatedBy")
  purchaseReturnsConfirmed    PurchaseReturn[]          @relation("PurchaseReturnConfirmedBy")
  purchaseReturnsCancelled    PurchaseReturn[]          @relation("PurchaseReturnCancelledBy")
  treasuriesCreated           Treasury[]                @relation("TreasuryCreatedBy")
  transfersCreated            TreasuryTransfer[]        @relation("TransferCreatedBy")
  transfersConfirmed          TreasuryTransfer[]        @relation("TransferConfirmedBy")
  transfersCancelled          TreasuryTransfer[]        @relation("TransferCancelledBy")

  historicalReturnArchivesImported HistoricalSalesReturnArchive[] @relation("HistoricalArchiveImportedBy")

  @@map("users")
}

// ========================= PaymentAccount ============================

enum PaymentAccountType {
  CASH
  BANK

  @@map("payment_account_type")
}

enum PaymentEntityType {
  SUPPLIER
  CUSTOMER

  @@map("payment_entity_type")
}

model PaymentAccount {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(100)
  type      PaymentAccountType
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments             Payment[]
  customerTransactions CustomerTransaction[]

  @@map("payment_accounts")
}

// ============================ Payment ================================

model Payment {
  id               String            @id @default(uuid()) @db.Uuid
  entityType       PaymentEntityType @map("entity_type")
  entityId         String            @map("entity_id") @db.Uuid
  paymentAccountId String            @map("payment_account_id") @db.Uuid
  amount           Decimal           @db.Decimal(14, 2)
  paymentDate      DateTime          @map("payment_date") @db.Date
  referenceNumber  String?           @map("reference_number") @db.VarChar(100)
  notes            String?           @db.VarChar(500)
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id])
  creator        User           @relation(fields: [createdBy], references: [id])

  @@index([entityType, entityId])
  @@index([paymentAccountId])
  @@map("payments")
}

model UserBranchAccess {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

// ============================ RefreshToken ===========================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(120)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(240)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================== ProductSku ===========================

model ProductSku {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(60)
  colorNameAr String          @map("color_name_ar") @db.VarChar(120)
  colorNameEn String          @map("color_name_en") @db.VarChar(120)
  category    ProductCategory @default(NORMAL)
  /// The purchase price typed when the product was first created, per square
  /// metre, in the same unit as a purchase invoice line. It is a STARTING
  /// FIGURE and a display fallback only: it is never posted, never a WAC, never
  /// an inventory value, and never pushed into an invoice. Once the product has
  /// a confirmed purchase, that purchase is what the catalogue shows. Nullable
  /// because every product that existed before this column did so without one.
  initialPurchasePricePerMeter Decimal? @map("initial_purchase_price_per_meter") @db.Decimal(14, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants ProductVariant[]

  @@map("product_skus")
}

// =========================== ProductVariant ==========================

model ProductVariant {
  id                            String    @id @default(uuid()) @db.Uuid
  skuId                         String    @map("sku_id") @db.Uuid
  sizeMetersPerBoard            Decimal   @map("size_meters_per_board") @db.Decimal(10, 4)
  defaultSalePricePerMeter      Decimal   @map("default_sale_price_per_meter") @db.Decimal(14, 2)
  defaultPurchasePricePerMeter  Decimal   @map("default_purchase_price_per_meter") @db.Decimal(14, 2)
  priceOverrideTolerancePercent Decimal?  @map("price_override_tolerance_percent") @db.Decimal(5, 2)
  // Phase 3A — weighted-average cost (WAC), server-maintained only. Starts at
  // 0 and builds forward from purchase postings (opening value = Phase 4).
  // avgCost is PER BOARD (legacy). avgCostPerMeter is the NEW canonical WAC per
  // SQUARE METER (the accountant's confirmed cost/valuation unit). Both are
  // maintained forward on every purchase; avgCost is kept only for compatibility.
  avgCost                       Decimal   @default(0) @map("avg_cost") @db.Decimal(14, 4)
  avgCostPerMeter               Decimal   @default(0) @map("avg_cost_per_meter") @db.Decimal(14, 4)
  costUpdatedAt                 DateTime? @map("cost_updated_at") @db.Timestamptz(6)
  active                        Boolean   @default(true)
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sku                  ProductSku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  inventoryBalances    BranchInventoryBalance[]
  inventoryMovements   InventoryMovement[]
  customerOrders       CustomerOrder[]
  factoryEntries       FactoryLedgerEntry[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  salesReturnLines     SalesReturnLine[]        @relation("SalesReturnLineVariant")
  purchaseReturnLines  PurchaseReturnLine[]     @relation("PurchaseReturnLineVariant")

  historicalReturnArchiveLines HistoricalSalesReturnArchiveLine[] @relation("HistoricalArchiveLineVariant")
  transferLines                InventoryTransferLine[]

  @@unique([skuId, sizeMetersPerBoard])
  @@index([skuId])
  @@map("product_variants")
}

// ============================== Supplier =============================

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String   @unique @map("name_ar") @db.VarChar(160)
  nameEn    String   @unique @map("name_en") @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factoryEntries   FactoryLedgerEntry[]
  purchaseInvoices PurchaseInvoice[]
  expenses         Expense[]
  paymentVouchers  PaymentVoucher[]
  purchaseReturns  PurchaseReturn[]     @relation("PurchaseReturnSupplier")

  @@map("suppliers")
}

// ========================= SalesRepresentative =======================
// A sales representative is an optional accounting/reporting DIMENSION, not a
// GL account. Its financial balance comes only from posted journal_lines that
// carry sales_representative_id; sales invoices are informational activity and
// never move the balance. Deactivate rather than delete once it has history.

model SalesRepresentative {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  nameAr    String   @map("name_ar") @db.VarChar(200)
  nameEn    String?  @map("name_en") @db.VarChar(200)
  phone     String?  @db.VarChar(30)
  address   String?  @db.VarChar(300)
  notes     String?  @db.VarChar(1000)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  salesInvoices  SalesInvoice[]
  salesReturns   SalesReturn[]  @relation("SalesReturnRep")
  journalEntries JournalEntry[]
  journalLines   JournalLine[]

  @@index([active])
  @@map("sales_representatives")
}

// ====================== BranchInventoryBalance =======================

model BranchInventoryBalance {
  branchId         String    @map("branch_id") @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  boardsOnHand     Decimal   @default(0) @map("boards_on_hand") @db.Decimal(14, 4)
  metersOnHand     Decimal   @default(0) @map("meters_on_hand") @db.Decimal(14, 4)
  lastCountedAt    DateTime? @map("last_counted_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@id([branchId, productVariantId])
  @@map("branch_inventory_balances")
}

// ========================== InventoryMovement ========================

model InventoryMovement {
  id                String       @id @default(uuid()) @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  productVariantId  String       @map("product_variant_id") @db.Uuid
  movementType      MovementType @map("movement_type")
  boardsQuantity    Decimal      @map("boards_quantity") @db.Decimal(14, 4)
  metersQuantity    Decimal      @map("meters_quantity") @db.Decimal(14, 4)
  referenceType     String?      @map("reference_type") @db.VarChar(40)
  referenceId       String?      @map("reference_id") @db.Uuid
  createdBy         String       @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  humanReadableNote String?      @map("human_readable_note") @db.Text

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  creator        User           @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([branchId, productVariantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

// ============================ CustomerOrder ==========================

model CustomerOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  branchId              String              @map("branch_id") @db.Uuid
  orderDate             DateTime            @default(now()) @map("order_date") @db.Date
  customerName          String              @map("customer_name") @db.VarChar(160)
  productVariantId      String              @map("product_variant_id") @db.Uuid
  boardsQuantity        Decimal             @map("boards_quantity") @db.Decimal(14, 4)
  metersQuantity        Decimal             @map("meters_quantity") @db.Decimal(14, 4)
  salePricePerMeter     Decimal             @map("sale_price_per_meter") @db.Decimal(14, 2)
  priceOverrideStatus   PriceOverrideStatus @default(WITHIN_TOLERANCE) @map("price_override_status")
  priceApprovedByUserId String?             @map("price_approved_by_user_id") @db.Uuid
  priceApprovedAt       DateTime?           @map("price_approved_at") @db.Timestamptz(6)
  requiredAmount        Decimal             @map("required_amount") @db.Decimal(14, 2)
  collectedAmount       Decimal             @default(0) @map("collected_amount") @db.Decimal(14, 2)
  remainingAmount       Decimal             @map("remaining_amount") @db.Decimal(14, 2)
  receiverName          String?             @map("receiver_name") @db.VarChar(160)
  status                OrderStatus         @default(DRAFT)
  salesInvoiceId        String?             @map("sales_invoice_id") @db.Uuid
  createdBy             String              @map("created_by") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  creator        User              @relation("CustomerOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  priceApprover  User?             @relation("CustomerOrderPriceApprovedBy", fields: [priceApprovedByUserId], references: [id], onDelete: SetNull)
  salesInvoice   SalesInvoice?     @relation("OrderSalesInvoice", fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  collections    OrderCollection[]

  @@index([branchId, orderDate(sort: Desc)])
  @@index([status])
  @@index([salesInvoiceId])
  @@map("customer_orders")
}

// ========================== OrderCollection ==========================

model OrderCollection {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  collectedAt    DateTime @default(now()) @map("collected_at") @db.Timestamptz(6)
  amount         Decimal  @db.Decimal(14, 2)
  paidToAccount  String?  @map("paid_to_account") @db.VarChar(120)
  cashAccountId  String?  @map("cash_account_id") @db.Uuid
  arAccountId    String?  @map("ar_account_id") @db.Uuid
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creator      User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cashAccount  Account?      @relation("CollectionCashAccount", fields: [cashAccountId], references: [id])
  arAccount    Account?      @relation("CollectionArAccount", fields: [arAccountId], references: [id])
  journalEntry JournalEntry? @relation("CollectionJournalEntry", fields: [journalEntryId], references: [id])

  @@index([orderId])
  @@map("order_collections")
}

// =============================== Expense =============================

model Expense {
  id                     String        @id @default(uuid()) @db.Uuid
  branchId               String        @map("branch_id") @db.Uuid
  expenseDate            DateTime      @map("expense_date") @db.Date
  description            String        @db.VarChar(240)
  amount                 Decimal       @db.Decimal(14, 2)
  paidFromAccount        String        @map("paid_from_account") @db.VarChar(120)
  glAccountId            String?       @map("gl_account_id") @db.Uuid
  paymentGlAccountId     String?       @map("payment_gl_account_id") @db.Uuid
  journalEntryId         String?       @map("journal_entry_id") @db.Uuid
  // Phase 3C (additive): category→account mapping, on-credit AP supplier, and
  // input-VAT metadata. All nullable/defaulted; legacy no-account expenses stay
  // record-only (journalEntryId null) for backward compatibility.
  expenseCategoryId      String?       @map("expense_category_id") @db.Uuid
  supplierId             String?       @map("supplier_id") @db.Uuid
  taxable                Boolean       @default(false)
  taxRateAtPosting       Decimal?      @map("tax_rate_at_posting") @db.Decimal(5, 2)
  // Phase 3D: reversal-hardening. status distinguishes record-only from
  // posted/reversed; reversalJournalEntryId points to the reversal entry
  // (the original journalEntryId stays linked to the original, now REVERSED).
  status                 ExpenseStatus @default(RECORDED)
  reversalJournalEntryId String?       @map("reversal_journal_entry_id") @db.Uuid
  createdBy              String        @map("created_by") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator          User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  glAccount        Account?         @relation("ExpenseGlAccount", fields: [glAccountId], references: [id])
  paymentGlAccount Account?         @relation("ExpensePaymentGlAccount", fields: [paymentGlAccountId], references: [id])
  journalEntry     JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  expenseCategory  ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])

  @@index([branchId, expenseDate(sort: Desc)])
  @@map("expenses")
}

// ======================== FactoryLedgerEntry =========================

model FactoryLedgerEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  supplierId            String   @map("supplier_id") @db.Uuid
  orderDate             DateTime @map("order_date") @db.Date
  productVariantId      String?  @map("product_variant_id") @db.Uuid
  boardsQuantity        Decimal? @map("boards_quantity") @db.Decimal(14, 4)
  metersQuantity        Decimal? @map("meters_quantity") @db.Decimal(14, 4)
  purchasePricePerMeter Decimal? @map("purchase_price_per_meter") @db.Decimal(14, 2)
  totalAmount           Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount            Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  runningBalance        Decimal  @default(0) @map("running_balance") @db.Decimal(14, 2)
  notes                 String?  @db.Text
  debitAccountId        String?  @map("debit_account_id") @db.Uuid
  creditAccountId       String?  @map("credit_account_id") @db.Uuid
  journalEntryId        String?  @map("journal_entry_id") @db.Uuid
  createdBy             String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  debitAccount     Account?          @relation("FactoryEntryDebitAccount", fields: [debitAccountId], references: [id])
  creditAccount    Account?          @relation("FactoryEntryCreditAccount", fields: [creditAccountId], references: [id])
  journalEntry     JournalEntry?     @relation("FactoryEntryJournal", fields: [journalEntryId], references: [id])
  purchaseInvoices PurchaseInvoice[]

  @@index([supplierId, orderDate])
  @@map("factory_ledger_entries")
}

// =============================== AuditLog ============================

model AuditLog {
